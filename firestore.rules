rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function sessionPath(sid) {
      return /databases/$(database)/documents/sessions/$(sid);
    }

    function debtPath(did) {
      return /databases/$(database)/documents/debts/$(did);
    }

    // Các field thay đổi giữa bản mới và bản cũ chỉ nằm trong [keys].
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function canWriteSessionExpenses(sessionId) {
      let parent = sessionPath(sessionId);
      return (exists(parent) &&
              get(parent).data.creatorId == request.auth.uid &&
              get(parent).data.status == 'open' &&
              getAfter(parent).data.status == 'open') ||
             (!exists(parent) &&
              getAfter(parent).data.creatorId == request.auth.uid &&
              getAfter(parent).data.status == 'open');
    }


    // Draft edits remain creator-trusted on Spark and must touch the parent.
    function editsOpenDraft(sid) {
      let before = get(sessionPath(sid)).data;
      let after = getAfter(sessionPath(sid)).data;
      return isSignedIn() && before.creatorId == request.auth.uid &&
        before.status == 'open' && after.status == 'open' &&
        after.lastExpenseMutationId is string &&
        (!('lastExpenseMutationId' in before) || after.lastExpenseMutationId != before.lastExpenseMutationId);
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Đọc: bất kỳ user đã đăng nhập (cần để tìm bạn bè theo email/uid).
    // Ghi: chỉ chính chủ.

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);

      // contacts sub-collection: chính chủ đọc/xoá, hoặc bạn bè tự thêm/cập nhật thông tin của mình khi kết bạn 2 chiều.
      match /contacts/{contactId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isSignedIn() &&
                                 (isOwner(uid) || request.auth.uid == contactId);
      }

      // notifications sub-collection: chính chủ đọc/xoá và cập nhật isRead
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid) && onlyChanges(['isRead']);
        allow create: if isSignedIn();
      }
    }

    // ── sessions ─────────────────────────────────────────────────────────────
    // Đọc: thành viên trong memberUserIds.
    // Tạo: chỉ creator, phiên mới luôn "open", tổng bill > 0.
    // Sửa: creator chỉ được đổi tên, hoặc chuyển open → closed (không sửa tiền).
    // Xoá: creator, chỉ khi phiên còn mở (chưa ghi nợ).

    match /sessions/{sessionId} {
      allow read: if isSignedIn() &&
                     request.auth.uid in resource.data.memberUserIds;

      allow create: if isSignedIn() &&
                       request.auth.uid == request.resource.data.creatorId &&
                       request.auth.uid in request.resource.data.memberUserIds &&
                       request.resource.data.status == 'open' &&
                       request.resource.data.totalAmount is int &&
                       request.resource.data.totalAmount > 0;

      // Spark trusted-client writes: creator may update title while open,
      // adjust total atomically with expense mutations, or close once.
      allow update: if isSignedIn() &&
                       request.auth.uid == resource.data.creatorId &&
                       resource.data.status == 'open' &&
                       request.resource.data.creatorId == resource.data.creatorId &&
                       ((request.resource.data.status == 'open' &&
                         onlyChanges(['title'])) ||
                        (request.resource.data.status == 'open' &&
                         onlyChanges(['title', 'totalAmount', 'memberUserIds', 'splitMode', 'lastExpenseMutationId']) &&
                         request.resource.data.memberUserIds is list &&
                         request.auth.uid in request.resource.data.memberUserIds &&
                         request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                         request.resource.data.totalAmount is int && request.resource.data.totalAmount > 0 &&
                         request.resource.data.splitMode == 'equal' &&
                         request.resource.data.lastExpenseMutationId is string) ||
                        (request.resource.data.status == 'open' &&
                         onlyChanges(['totalAmount', 'lastExpenseMutationId']) &&
                         request.resource.data.totalAmount is int &&
                         request.resource.data.totalAmount > 0 &&
                         request.resource.data.lastExpenseMutationId is string) ||
                        (request.resource.data.status == 'closed' &&
                         onlyChanges(['status', 'closedAt', 'totalAmount', 'closeResult']) &&
                         request.resource.data.totalAmount == resource.data.totalAmount &&
                         request.resource.data.closeResult is map &&
                         request.resource.data.closeResult.totalAmount == request.resource.data.totalAmount));

      allow delete: if isSignedIn() &&
                       request.auth.uid == resource.data.creatorId &&
                       resource.data.status == 'open';

      // Itemized expense writes are client-trusted, constrained to an open
      // session's creator and paired with a total update in the same batch.
      match /expenses/{expenseId} {
        allow read: if isSignedIn() &&
                       (exists(sessionPath(sessionId))
                          ? request.auth.uid in get(sessionPath(sessionId)).data.memberUserIds
                          : request.auth.uid in getAfter(sessionPath(sessionId)).data.memberUserIds);
        allow create, update, delete: if isSignedIn() &&
          canWriteSessionExpenses(sessionId) &&
          (request.method == 'delete' ||
            (request.resource.data.amount is int &&
             request.resource.data.amount > 0 &&
             existsAfter(/databases/$(database)/documents/sessions/$(sessionId)/members/$(request.resource.data.payerId)) &&
             getAfter(/databases/$(database)/documents/sessions/$(sessionId)/members/$(request.resource.data.payerId)).data.userId in getAfter(sessionPath(sessionId)).data.memberUserIds &&
             request.resource.data.participantIds is list &&
             request.resource.data.participantIds.size() > 0 &&
             request.resource.data.shares is map &&
             request.resource.data.description is string &&
             request.resource.data.description.size() > 0));
      }

      match /guestObligations/{obligationId} {
        allow read: if isSignedIn() &&
                       request.auth.uid in get(sessionPath(sessionId)).data.memberUserIds;
        allow create: if isSignedIn() &&
          get(sessionPath(sessionId)).data.creatorId == request.auth.uid &&
          get(sessionPath(sessionId)).data.status == 'open' &&
          getAfter(sessionPath(sessionId)).data.status == 'closed' &&
          request.resource.data.sessionId == sessionId &&
          request.resource.data.payerId in get(sessionPath(sessionId)).data.memberUserIds &&
          request.resource.data.amount is int && request.resource.data.amount > 0 &&
          request.resource.data.status == 'pending';
        allow update: if isSignedIn() &&
          request.auth.uid == resource.data.payerId &&
          request.resource.data.status == 'collected' &&
          resource.data.status == 'pending' &&
          onlyChanges(['status', 'collectedAt', 'collectedBy']) &&
          request.resource.data.collectedBy == request.auth.uid;
        allow delete: if false;
      }

      // members: thành viên đọc. Creator tạo cùng lúc với phiên (số tiền hợp lệ,
      // không vượt tổng bill). Sau đó chỉ đổi được status/paidAt, không sửa tiền.
      match /members/{memberId} {
        allow read: if isSignedIn() &&
                       request.auth.uid in get(sessionPath(sessionId)).data.memberUserIds;

        allow create: if isSignedIn() &&
                         getAfter(sessionPath(sessionId)).data.creatorId == request.auth.uid &&
                         getAfter(sessionPath(sessionId)).data.status == 'open' &&
                         request.resource.data.isGuest is bool &&
                         ((request.resource.data.isGuest && request.resource.data.userId == null) ||
                          (!request.resource.data.isGuest && request.resource.data.userId in getAfter(sessionPath(sessionId)).data.memberUserIds)) &&
                         request.resource.data.amountOwed is int &&
                         request.resource.data.amountOwed >= 0 &&
                         request.resource.data.amountOwed <= getAfter(sessionPath(sessionId)).data.totalAmount &&
                         request.resource.data.amountPaid is int &&
                         request.resource.data.amountPaid >= 0 &&
                         request.resource.data.amountPaid <= getAfter(sessionPath(sessionId)).data.totalAmount;

        // Creator may write computed accounting fields only while closing;
        // this is intentionally trusted-client, not server-authoritative.
        allow update: if isSignedIn() &&
          ((editsOpenDraft(sessionId) &&
            onlyChanges(['displayName', 'amountOwed', 'amountPaid', 'status', 'paidAt']) &&
            request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.isGuest == resource.data.isGuest &&
            request.resource.data.amountOwed is int && request.resource.data.amountOwed >= 0 &&
            request.resource.data.amountOwed <= getAfter(sessionPath(sessionId)).data.totalAmount &&
            request.resource.data.amountPaid is int && request.resource.data.amountPaid >= 0 &&
            request.resource.data.amountPaid <= getAfter(sessionPath(sessionId)).data.totalAmount &&
            (request.resource.data.isGuest || request.resource.data.userId in getAfter(sessionPath(sessionId)).data.memberUserIds)) ||
                         get(sessionPath(sessionId)).data.creatorId == request.auth.uid &&
                         get(sessionPath(sessionId)).data.status == 'open' &&
                         getAfter(sessionPath(sessionId)).data.status == 'closed' &&
                         onlyChanges(['amountOwed', 'amountPaid', 'status', 'paidAt']) &&
                         request.resource.data.amountOwed is int &&
                         request.resource.data.amountOwed >= 0 &&
                         request.resource.data.amountPaid is int &&
                         request.resource.data.amountPaid >= 0);

        allow delete: if isSignedIn() &&
                         get(sessionPath(sessionId)).data.creatorId == request.auth.uid &&
                         get(sessionPath(sessionId)).data.status == 'open' &&
                         (!existsAfter(sessionPath(sessionId)) || memberId != request.auth.uid);
      }
    }

    // ── debts ────────────────────────────────────────────────────────────────
    // `balance` KHÔNG bao giờ được ghi tự do. Nó chỉ đổi theo đúng 2 cách,
    // mỗi cách gắn với một bản ghi bất biến:
    //   1. Đóng phiên   → debts/{id}/entries/{sessionId}  (creator tạo)
    //   2. Xác nhận trả → debts/{id}/payments/{paymentId} (chủ nợ xác nhận)
    // và độ thay đổi của balance phải bằng đúng số tiền trong bản ghi đó.

    // Số dư cũ (0 nếu khoản nợ chưa tồn tại).
    function oldBalance() {
      return resource == null ? 0 : resource.data.balance;
    }

    // Đúng 1 bản ghi entries mới (tạo trong cùng lần ghi) và balance đổi khớp nó.
    function closingEntryMatches(debtId) {
      let sid = request.resource.data.lastEntryId;
      let entryPath = /databases/$(database)/documents/debts/$(debtId)/entries/$(sid);
      let entry = getAfter(entryPath).data;
      return !exists(entryPath) &&
             entry.fromUserId in [request.resource.data.userA, request.resource.data.userB] &&
             entry.toUserId in [request.resource.data.userA, request.resource.data.userB] &&
             request.resource.data.balance - oldBalance() ==
               (entry.fromUserId == request.resource.data.userA ? entry.amount : -entry.amount);
    }

    match /debts/{debtId} {
      allow read: if isSignedIn() &&
                     request.auth.uid in resource.data.participants;

      // New debt documents are created only by a creator closing a session.
      allow create: if isSignedIn() &&
                       request.resource.data.userA < request.resource.data.userB &&
                       debtId == request.resource.data.userA + '_' + request.resource.data.userB &&
                       request.resource.data.participants == [request.resource.data.userA, request.resource.data.userB] &&
                       !('pendingPaymentId' in request.resource.data) &&
                       request.resource.data.lastEntryId is string &&
                       closingEntryMatches(debtId) &&
                       get(sessionPath(request.resource.data.lastEntryId)).data.creatorId == request.auth.uid &&
                       get(sessionPath(request.resource.data.lastEntryId)).data.status == 'open' &&
                       getAfter(sessionPath(request.resource.data.lastEntryId)).data.status == 'closed' &&
                       request.resource.data.userA in get(sessionPath(request.resource.data.lastEntryId)).data.memberUserIds &&
                       request.resource.data.userB in get(sessionPath(request.resource.data.lastEntryId)).data.memberUserIds;

      allow update: if isSignedIn() &&
                       (
                         // (a) Con nợ đánh dấu "Tôi đã chuyển": chỉ gắn pendingPaymentId.
                         (request.auth.uid in resource.data.participants &&
                          onlyChanges(['pendingPaymentId']) &&
                          !('pendingPaymentId' in resource.data) &&
                          getAfter(/databases/$(database)/documents/debts/$(debtId)/payments/$(request.resource.data.pendingPaymentId)).data.fromUserId == request.auth.uid) ||

                         // (b) Chủ nợ xác nhận payment đang chờ: balance đổi đúng bằng số tiền.
                         (request.auth.uid in resource.data.participants &&
                          onlyChanges(['balance', 'pendingPaymentId', 'updatedAt']) &&
                          !('pendingPaymentId' in request.resource.data) &&
                          confirmMatches(debtId)) ||

                         // (c) Closing a session: creator adds an entry for
                         // current session members with matching balance delta.
                         (onlyChanges(['balance', 'lastEntryId', 'updatedAt']) &&
                          !('pendingPaymentId' in resource.data) &&
                          request.resource.data.lastEntryId is string &&
                          closingEntryMatches(debtId) &&
                          get(sessionPath(request.resource.data.lastEntryId)).data.creatorId == request.auth.uid &&
                          get(sessionPath(request.resource.data.lastEntryId)).data.status == 'open' &&
                          getAfter(sessionPath(request.resource.data.lastEntryId)).data.status == 'closed' &&
                          request.resource.data.userA in get(sessionPath(request.resource.data.lastEntryId)).data.memberUserIds &&
                          request.resource.data.userB in get(sessionPath(request.resource.data.lastEntryId)).data.memberUserIds) ||

                         // (d) Chủ nợ gửi lời nhắc thanh toán: chỉ cập nhật mốc lastReminderAt
                         (onlyChanges(['lastReminderAt']) &&
                          request.auth.uid in resource.data.participants)
                       );

      allow delete: if false;

      function confirmMatches(debtId) {
        let pid = resource.data.pendingPaymentId;
        let paymentPath = /databases/$(database)/documents/debts/$(debtId)/payments/$(pid);
        let payment = get(paymentPath).data;
        return getAfter(paymentPath).data.status == 'confirmed' &&
               payment.status == 'pending' &&
               payment.toUserId == request.auth.uid &&
               request.resource.data.balance - resource.data.balance ==
                 (payment.fromUserId == resource.data.userA ? -payment.amount : payment.amount);
      }

      // Bản ghi cộng nợ của từng phiên: bất biến, chỉ creator của phiên đang đóng tạo.
      match /entries/{entryId} {
        allow read: if isSignedIn() &&
                       request.auth.uid in get(debtPath(debtId)).data.participants;

        allow create: if isSignedIn() &&
                         entryId == request.resource.data.sessionId &&
                         request.resource.data.fromUserId != request.resource.data.toUserId &&
                         request.resource.data.amount is int &&
                         request.resource.data.amount > 0 &&
                         request.resource.data.amount <= get(sessionPath(entryId)).data.totalAmount &&
                         get(sessionPath(entryId)).data.creatorId == request.auth.uid &&
                         get(sessionPath(entryId)).data.status == 'open' &&
                         getAfter(sessionPath(entryId)).data.status == 'closed' &&
                         request.resource.data.fromUserId in get(sessionPath(entryId)).data.memberUserIds &&
                         request.resource.data.toUserId in get(sessionPath(entryId)).data.memberUserIds &&
                         debtId == (request.resource.data.fromUserId < request.resource.data.toUserId
                                      ? request.resource.data.fromUserId + '_' + request.resource.data.toUserId
                                      : request.resource.data.toUserId + '_' + request.resource.data.fromUserId);

        allow update, delete: if false;
      }

      // payments: con nợ tạo (đúng số đang nợ), chủ nợ xác nhận (không sửa số tiền).
      match /payments/{paymentId} {
        allow read: if isSignedIn() &&
                       request.auth.uid in get(debtPath(debtId)).data.participants;

        allow create: if isSignedIn() &&
                         request.auth.uid == request.resource.data.fromUserId &&
                         request.resource.data.fromUserId != request.resource.data.toUserId &&
                         request.resource.data.fromUserId in get(debtPath(debtId)).data.participants &&
                         request.resource.data.toUserId in get(debtPath(debtId)).data.participants &&
                         request.resource.data.status == 'pending' &&
                         request.resource.data.amount is int &&
                         request.resource.data.amount > 0 &&
                         request.resource.data.amount ==
                           (request.resource.data.fromUserId == get(debtPath(debtId)).data.userA
                              ? get(debtPath(debtId)).data.balance
                              : -get(debtPath(debtId)).data.balance) &&
                         getAfter(debtPath(debtId)).data.pendingPaymentId == paymentId;

        allow update: if isSignedIn() &&
                         request.auth.uid == resource.data.toUserId &&
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'confirmed' &&
                         onlyChanges(['status', 'confirmedAt']);

        allow delete: if false;
      }
    }
  }
}
